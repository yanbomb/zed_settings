[
  {
    "label": "r/python",
    "command": "python3",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
  },
  {
    "label": "uv/python",
    "command": "uv run",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "show_command": true,
    "reveal": "always",
  },
  {
    "label": "r/rust",
    "command": "sh",
    "args": ["-c", "clear; cargo run -q"],
    "cwd": "$ZED_WORKTREE_ROOT/main",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
  },
]
